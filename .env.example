# Discord Bot Configuration
# ⚠️ SECURITY: Never commit your actual .env file to git!
# Copy this file to .env and fill in your actual values

# Your Discord Bot Token from https://discord.com/developers/applications
# Find it under: Bot > TOKEN (click "Reset Token" to view)
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord Server (Guild) ID
# Get it by: Enable Developer Mode > Right-click server > Copy Server ID
DISCORD_GUILD_ID=your_server_id_here

# Template file to use (optional, defaults to vibe-coding-template.json)
TEMPLATE_FILE=vibe-coding-template.json

# Deployment options (optional)
DRY_RUN=false
LOG_LEVEL=info
